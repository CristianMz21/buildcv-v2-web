# Origin of BuildCv.Api. Only the Next.js server reads this — it is never sent to the browser,
# which is why it has no NEXT_PUBLIC_ prefix.
#
# `dotnet run --project src/BuildCv.Api` binds :5062 from the API's launch settings, which is also
# the dev fallback in src/lib/backend.ts and what playwright.config.ts starts the suite against.
# Check the console output on first run and match it here if your checkout differs.
BUILDCV_API_ORIGIN=http://localhost:5062

# Only the e2e suite reads this. Set it to run against an already-running server — a deployed
# instance, or one you started yourself — instead of letting playwright.config.ts start its own on
# :3210. Leave it unset for normal runs: the suite starting its own server is what stops a pass from
# being scored against a stale one.
# BUILDCV_WEB_ORIGIN=http://localhost:3000

# Set to 1 when pointing at an https API whose certificate is the ASP.NET Core dev certificate.
# Node rejects it otherwise. Never set this outside local development.
#
# YOU ALSO HAVE TO START THE API DIFFERENTLY, and this is the part that wastes an afternoon: the
# command above uses the `http` launch profile, which is the FIRST one in launchSettings.json and
# therefore what a bare `dotnet run` picks. It binds 5062 and nothing else — :7160 never comes up, so
# this flag has nothing to apply to and the connection is simply refused. Use
# `dotnet run --project src/BuildCv.Api --launch-profile https`, which binds both.
BUILDCV_ALLOW_SELF_SIGNED=0

# Set to 1 ONLY when a trusted proxy terminates traffic in front of this container and overwrites
# `X-Forwarded-For` on ingress — Azure Container Apps and Caddy both do. It makes every call to the
# API carry the real client address, which is what lets the API's rate limiter tell users apart.
#
# Without it the whole deployment is one client to the API: its limiters partition on the peer
# address, which is this container for every request anybody makes. Five failed sign-ins by anyone
# lock out sign-in, registration, refresh and password reset for everybody, and a global 100/min
# ceiling applies to the entire product at once.
#
# Measured: Next passes a client-supplied X-Forwarded-For through unchanged. With no proxy
# overwriting it, a caller can claim any address, so `1` without a proxy is worse than `0`.
BUILDCV_TRUST_PROXY=0
